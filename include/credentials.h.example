#pragma once

// =============================================================================
// TTN OTAA — CREDENCIALES  ·  PLANTILLA SIN CLAVES REALES
// =============================================================================
//
//  >>> ESTE FICHERO NO CONTIENE CLAVES REALES <<<
//  Los valores originales se han eliminado antes de publicar el proyecto.
//
// -----------------------------------------------------------------------------
// CÓMO RELLENARLO
// -----------------------------------------------------------------------------
// Los valores se obtienen en la consola de The Things Network:
//
//     Applications  ->  [tu aplicación]  ->  End devices  ->  [tu dispositivo]
//
//   1. Copia cada valor en formato MSB-first (big-endian), que es como
//      los espera RadioLib.
//   2. Sustituye los ceros de los arrays de abajo por tus bytes.
//   3. NO subas este fichero relleno a ningún repositorio público.
//      Está incluido en .gitignore precisamente para evitarlo.
//
// -----------------------------------------------------------------------------
// SEGURIDAD
// -----------------------------------------------------------------------------
// La AppKey es la clave raíz de cifrado del dispositivo. Quien la tenga puede
// suplantar al nodo en la red y descifrar su tráfico. Si en algún momento se
// ha expuesto (por ejemplo, en un commit antiguo), NO basta con borrarla del
// código: hay que REGENERARLA en la consola de TTN.
//
// Para compartir el proyecto, publica solo `credentials.h.example`.
// =============================================================================


// -----------------------------------------------------------------------------
// JoinEUI (antiguamente AppEUI)
// En TTN es habitual dejarlo todo a ceros; no es un dato secreto.
// -----------------------------------------------------------------------------
static const uint8_t JOIN_EUI[8] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

// -----------------------------------------------------------------------------
// DevEUI — identificador único del dispositivo (lo asigna TTN o el fabricante).
// No es una clave de cifrado, pero identifica al equipo: se omite aquí.
// -----------------------------------------------------------------------------
static const uint8_t DEV_EUI[8] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00   // <-- SUSTITUIR
};

// -----------------------------------------------------------------------------
// AppKey — CLAVE SECRETA. Nunca debe publicarse.
// -----------------------------------------------------------------------------
static const uint8_t APP_KEY[16] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // <-- SUSTITUIR
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

// -----------------------------------------------------------------------------
// NwkKey — CLAVE SECRETA. Solo se usa en LoRaWAN 1.1.
// En TTN con LoRaWAN 1.0.x este proyecto pasa APP_KEY en ambos parámetros,
// por lo que este array puede quedarse a ceros.
// -----------------------------------------------------------------------------
static const uint8_t NWK_KEY[16] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // <-- SUSTITUIR (si LoRaWAN 1.1)
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};
